# Copy to .env (never committed) and fill in the values from the Azure checklist in issue #248.
# Uncomment only lines with a value: an empty value would override appsettings.json with "".

# AzureAdB2C__Instance=
# AzureAdB2C__Domain=
# AzureAdB2C__ClientId=
# AzureAdB2C__SignUpSignInPolicyId=
# AzureAdB2C__B2cExtensionAppClientId=
# AzureAdB2C__ClientSecret=

# Optional overrides of the local ports and the SQL Server password:
